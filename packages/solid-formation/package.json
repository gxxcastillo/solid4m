{
  "name": "solid-formation",
  "version": "0.2.0",
  "type": "module",
  "description": "Typed, accessible, SSR-ready forms for SolidJS",
  "keywords": [
    "solid",
    "solidjs",
    "solid-js",
    "form",
    "forms",
    "validation",
    "standard-schema",
    "solid-start"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/gxxcastillo/solid-formation",
    "directory": "packages/solid-formation"
  },
  "homepage": "https://gxxcastillo.github.io/solid-formation/",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "node": "./dist/server/index.js",
      "worker": "./dist/server/index.js",
      "deno": "./dist/server/index.js",
      "browser": "./dist/index.js",
      "import": "./dist/index.js",
      "development": "./src/index.ts"
    },
    "./styles.css": "./dist/style.css",
    "./themes/base.css": {
      "development": "./themes/base.css",
      "default": "./dist/themes/base.css"
    },
    "./themes/minimal.css": {
      "development": "./themes/minimal.css",
      "default": "./dist/themes/minimal.css"
    },
    "./themes/midnight.css": {
      "development": "./themes/midnight.css",
      "default": "./dist/themes/midnight.css"
    },
    "./themes/neobrutalist.css": {
      "development": "./themes/neobrutalist.css",
      "default": "./dist/themes/neobrutalist.css"
    }
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "node": "./dist/server/index.js",
        "worker": "./dist/server/index.js",
        "deno": "./dist/server/index.js",
        "browser": "./dist/index.js",
        "import": "./dist/index.js"
      },
      "./styles.css": "./dist/style.css",
      "./themes/base.css": "./dist/themes/base.css",
      "./themes/minimal.css": "./dist/themes/minimal.css",
      "./themes/midnight.css": "./dist/themes/midnight.css",
      "./themes/neobrutalist.css": "./dist/themes/neobrutalist.css"
    }
  },
  "scripts": {
    "prepublishOnly": "node scripts/build.mjs",
    "postpublish": "git tag solid-formation@$(node -p \"require('./package.json').version\") && git push origin solid-formation@$(node -p \"require('./package.json').version\")"
  },
  "files": [
    "dist"
  ],
  "devDependencies": {
    "@gxxc/solid-formation-fields": "workspace:^",
    "@gxxc/solid-formation-form": "workspace:^",
    "@gxxc/solid-formation-state": "workspace:^",
    "type-fest": "^4.24.0",
    "typescript": "5.4.2",
    "vite": "^5.4.0",
    "vite-plugin-dts": "^3.9.1",
    "vite-plugin-solid": "^2.3.0"
  },
  "peerDependencies": {
    "solid-js": "^1.8.20"
  }
}
